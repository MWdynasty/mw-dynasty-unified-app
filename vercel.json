{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/mw.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mwdynasty.com"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*MWDynasty-iOS.*"
        }
      ],
      "destination": "https://app.mwdynasty.com/:path*",
      "permanent": false
    },
    {
      "source": "/signin",
      "destination": "/account/",
      "permanent": false
    },
    {
      "source": "/profile",
      "destination": "/account/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "founder.mwdynasty.com"
        }
      ],
      "destination": "/founder/"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mwdynasty.com"
        }
      ],
      "destination": "/api/public-site?path=:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mwdynasty.com"
        }
      ],
      "destination": "/api/public-site?path=:path*"
    },
    {
      "source": "/api/chat",
      "destination": "/api/mw?route=chat"
    },
    {
      "source": "/api/me",
      "destination": "/api/mw?route=me"
    },
    {
      "source": "/api/pace-chat",
      "destination": "/api/mw?route=pace-chat"
    },
    {
      "source": "/api/pricing",
      "destination": "/api/mw?route=pricing"
    },
    {
      "source": "/api/billing",
      "destination": "/api/mw?route=billing"
    },
    {
      "source": "/api/diagnostics",
      "destination": "/api/mw?route=diagnostics"
    },
    {
      "source": "/api/founder",
      "destination": "/api/mw?route=founder"
    },
    {
      "source": "/api/founder/ai",
      "destination": "/api/mw?route=founder/ai"
    },
    {
      "source": "/api/stripe/checkout",
      "destination": "/api/mw?route=stripe/checkout"
    },
    {
      "source": "/api/stripe/portal",
      "destination": "/api/mw?route=stripe/portal"
    },
    {
      "source": "/api/profile",
      "destination": "/api/mw?route=profile"
    },
    {
      "source": "/api/program",
      "destination": "/api/mw?route=program"
    },
    {
      "source": "/api/smart-entry",
      "destination": "/api/mw?route=smart-entry"
    },
    {
      "source": "/api/season-calendar",
      "destination": "/api/mw?route=season-calendar"
    },
    {
      "source": "/api/speak",
      "destination": "/api/mw?route=speak"
    },
    {
      "source": "/api/status",
      "destination": "/api/mw?route=status"
    },
    {
      "source": "/api/coach/access",
      "destination": "/api/mw?route=coach/access"
    },
    {
      "source": "/api/coach/athlete",
      "destination": "/api/mw?route=coach/athlete"
    },
    {
      "source": "/api/coach/invite",
      "destination": "/api/mw?route=coach/invite"
    },
    {
      "source": "/api/coach/notifications",
      "destination": "/api/mw?route=coach/notifications"
    },
    {
      "source": "/api/coach/program-import",
      "destination": "/api/mw?route=coach/program-import"
    },
    {
      "source": "/api/coach/attendance",
      "destination": "/api/mw?route=coach/attendance"
    },
    {
      "source": "/api/coach/coach-mw",
      "destination": "/api/mw?route=coach/coach-mw"
    },
    {
      "source": "/api/coach/program",
      "destination": "/api/mw?route=coach/program"
    },
    {
      "source": "/api/coach/performance",
      "destination": "/api/mw?route=coach/performance"
    },
    {
      "source": "/api/coach/progression",
      "destination": "/api/mw?route=coach/progression"
    },
    {
      "source": "/api/coach/roster",
      "destination": "/api/mw?route=coach/roster"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(self), microphone=(self)"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://keqgunlfwhjgcsurynef.supabase.co; media-src 'self' data: blob:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://keqgunlfwhjgcsurynef.supabase.co; object-src 'none'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
